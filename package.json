{
  "name": "qa-checks-post-migration",
  "version": "1.0.0",
  "description": "Playwright TypeScript suite for responsiveness QA, cross-browser validation, and Core Web Vitals measurement",
  "scripts": {
    "test": "playwright test",
    "test:responsive": "playwright test tests/responsiveness.spec.ts",
    "test:browsers": "playwright test tests/cross-browser.spec.ts",
    "test:cwv": "playwright test tests/cwv.spec.ts",
    "test:chrome": "playwright test --project=chromium-desktop",
    "test:firefox": "playwright test --project=firefox-desktop",
    "test:safari": "playwright test --project=webkit-desktop",
    "test:mobile": "playwright test --project=chromium-mobile",
    "test:desktop": "playwright test --project=chromium-desktop",
    "report": "open reports/qa-report.html",
    "clean": "rm -rf screenshots reports test-results .qa-runtime",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "testing",
    "wordpress",
    "migration",
    "qa",
    "automation"
  ],
  "author": "QA Automation Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "papaparse": "^5.4.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
